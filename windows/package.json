{
  "name": "notchlyrics-windows",
  "version": "2.4.0",
  "description": "Synchronized karaoke lyrics overlay with Golden Ratio OLED Notch UI for Windows 10/11 and Linux",
  "homepage": "https://notchlyrics.mrr.my.id",
  "repository": "https://github.com/Rafli161102/notchlyrics",
  "main": "main.js",
  "license": "MIT",
  "author": "TouchBarLyrics Contributors <noreply@notchlyrics.mrr.my.id>",
  "scripts": {
    "start": "electron .",
    "test": "node tests/lyrics-engine.test.js && node tests/mpris-bridge.test.js",
    "dist:win": "electron-builder --win --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.user.NotchLyrics",
    "productName": "NotchLyrics",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lyrics-engine.js",
      "mpris_bridge.js",
      "i18n.js",
      "win_smtc.ps1",
      "assets/**/*",
      "renderer/**/*"
    ],
    "linux": {
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "maintainer": "TouchBarLyrics Contributors <noreply@notchlyrics.mrr.my.id>",
      "vendor": "TouchBarLyrics Contributors",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
